# ========================================================
# AIR POWER - SIH 26250 EXCLUSION LIST (.gitignore)
# ========================================================
# Clearly grouped repository exclusions. Designed to maintain
# professional evaluator visibility while keeping internal/agent
# directives, local caches, and transient test traces local.
# ========================================================

# --- 1. Agent Directives & Prompt Histories ---
AGENTS.md
CONTEXT.md
docs/PROMPT_HISTORY.md
docs/SIH_PRESENTATION_KIT.md
.local/
.agents/
.gemini/
/*prompt*.md
docs/*prompt*.md
docs/*PROMPT*.md

# --- 2. Temporary Scratch Files & Internal Notes ---
scratch/
scratchpad*
*.draft.md
*.tmp*
*.bak
*.swp
*~

# --- 3. Dependencies & Package Stores ---
node_modules/
.pnpm-store/

# --- 4. Build Outputs & Compilation Caches ---
dist/
build/
out/
.next/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# --- 5. Media & Visual Regression Dumps (With Whitelist) ---
# Ignore visual regression screenshot dumps and temp media:
docs/bugs/
test-results/
playwright-report/
blob-report/
recordings/
videos/
screencasts/
*.mp4
*.mkv
*.mov
*.avi
*.webm

# Default ignore for bulk images, with explicit evaluator whitelist:
*.png
*.jpg
*.jpeg

# DO NOT OVER-IGNORE: Whitelist README assets, architecture diagrams, and web icons:
!docs/media/**
!docs/assets/**
!apps/web/public/**

# --- 6. Raw Benchmark Per-Seed Dumps & Profiling Traces ---
benchmarks/results/*
!benchmarks/results/benchmark-summary.json
!benchmarks/results/optimality_gap.json
benchmarks/human/raw/
*.cpuprofile
clinic/
.clinic/

# --- 7. Logs & Process Traces ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 8. Test Coverage Reports ---
coverage/
.nyc_output/
*.lcov

# --- 9. Environment & Secrets ---
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# --- 10. IDE, Editor & OS Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
