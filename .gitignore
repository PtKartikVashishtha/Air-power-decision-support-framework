# =============================================================================
# AIR POWER (SIH 26250) — PRODUCTION & ARTIFACT GITIGNORE
# =============================================================================
# Cleanly grouped, path-scoped repository exclusions designed for professional
# SIH defence evaluation. Keeps production tooling, video pipeline renders,
# presentation generators, agent prompts, and test traces local to this machine.
# =============================================================================

# --- 1. Production Studio & Tooling (Video, Decks, Compiler, Diagnostics) ---
/studio/
/.local/
/.archify/
docs/cleanup/

# --- 2. Agent Directives & Prompt Histories ---
AGENTS.md
CONTEXT.md
*prompt*.md
docs/*prompt*.md
docs/*PROMPT*.md
.agents/
.gemini/
.claude/
.cursor/

# --- 3. Rendered Video & Audio Deliverables ---
*.mp4
*.mkv
*.mov
*.webm
*.avi
*.wav
*.mp3
*.srt
*.vtt
/video/
/video-studio/
/out/
recordings/
videos/
screencasts/

# --- 4. Presentation Decks & Office Intermediates ---
*.pptx
*.ppt
*.potx
*.ppsx
ppt/

# --- 5. Dependencies & Package Stores ---
node_modules/
.pnpm-store/
tools/

# --- 6. Build Outputs & Compilation Caches ---
dist/
build/
.next/
/apps/web/out/
/out/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts

# --- 7. Benchmark Raw Dumps (Summary JSON is kept) ---
benchmarks/results/*.csv
benchmarks/results/scale_benchmark_report.json
benchmarks/results/solver-microbenchmark-results.json

# --- 7. Test Reports, Coverage & Playwright Traces ---
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
docs/bugs/
docs/demo-rehearsal/

# --- 8. Temporary Scratch Files & Editor Artifacts ---
scratch/
scratchpad*
*.draft.md
*.tmp*
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.vscode/

# --- 9. Environment & Secrets ---
.env
.env*.local
*.pem
*.key

# --- 10. Evaluator Whitelist Exceptions ---
# Explicitly preserve evaluator-facing visuals, architecture diagrams, and web assets:
!docs/media/**
!docs/diagrams/out/**
!docs/diagrams/index.md
!apps/web/public/**
